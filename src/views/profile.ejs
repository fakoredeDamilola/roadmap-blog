<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>User Profile</title>
    <link
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha1/dist/css/bootstrap.min.css"
      rel="stylesheet"
    />
    <link rel="stylesheet" href="styles.css" />
    <style>
      .profile-info,
      .articles-section {
        padding: 20px;
      }
      .profile-header {
        margin-bottom: 20px;
      }
      .no-articles {
        color: #888;
      }
    </style>
  </head>
  <body>
    <%- include('partials/header', { routes:[{name: "Home", route: "/"}, {name:
    "Profile", route: "#"}], profilePicture: '/path/to/profile.jpg', userName:
    user?.username }) %>

    <div class="container mt-5">
      <div class="profile-header text-center">
        <h1>Welcome, <%= user.name %>!</h1>
        <p><strong>Email:</strong> <%= user.email %></p>
        <p><strong>Auth Method:</strong> <%= user.signinMethod %></p>
        <p>
          <strong>Member Since:</strong> <%= new
          Date(user.createdAt).toDateString() %>
        </p>
      </div>

      <ul class="nav nav-tabs" id="profile-tab" role="tablist">
        <li class="nav-item" role="presentation">
          <button
            class="nav-link active"
            id="profile-tab-button"
            data-bs-toggle="tab"
            data-bs-target="#profile-info"
            type="button"
            role="tab"
            aria-controls="profile-info"
            aria-selected="true"
          >
            Profile Info
          </button>
        </li>

        <li class="nav-item" role="presentation">
          <button
            class="nav-link"
            id="articles-tab-button"
            data-bs-toggle="tab"
            data-bs-target="#user-articles"
            type="button"
            role="tab"
            aria-controls="user-articles"
            aria-selected="false"
          >
            Articles (<%= articles?.length %>)
          </button>
        </li>
      </ul>

      <!-- Tab Contents -->
      <div class="tab-content mt-4">
        <!-- Profile Info Section -->
        <div
          class="tab-pane fade show active profile-info"
          id="profile-info"
          role="tabpanel"
          aria-labelledby="profile-tab-button"
        >
          <h3>Personal Information</h3>
          <p><strong>Name:</strong> <%= user.name %></p>
          <p><strong>Email:</strong> <%= user.email %></p>
          <p><strong>Auth ID:</strong> <%= user.authId %></p>
          <p><strong>Sign-in Method:</strong> <%= user.signinMethod %></p>
          <p>
            <strong>Description:</strong> <%= user.description ?
            user.description : 'No description provided' %>
          </p>
        </div>

        <div
          class="tab-pane fade articles-section"
          id="user-articles"
          role="tabpanel"
          aria-labelledby="articles-tab-button"
        >
          <h3>Your Articles</h3>
          <p class="no-articles">
            <button class="nav_createButton">
              <a href="/admin/new-article">Create Article</a>
            </button>
          </p>
          <ul class="list-group">
            <% articles?.forEach((article, index) => { %>
            <li class="list-group-item">
              <div class="article_flex">
                <div>
                  <a href="/article/<%= article.slug %>"
                    ><%= article.title %></a
                  >
                </div>
                <div class="article_buttons">
                  <div><%= article.createdAt %></div>
                  <button
                    class="edit_button"
                    onclick="navigateToRoute('/admin/edit-article/<%= article.slug %>')"
                  >
                    Edit
                  </button>
                  <button
                    class="delete_button"
                    onclick="deleteArticle('<%= article.slug %>')"
                  >
                    Delete
                  </button>
                </div>
              </div>
            </li>
            <% }); %>
          </ul>
        </div>
      </div>
    </div>
    <script>
      function navigateToRoute(route) {
        window.location.href = route;
      }
      function deleteArticle(slug) {
        if (confirm("Are you sure you want to delete this article?")) {
          fetch(`/admin/delete-article/${slug}`, {
            method: "DELETE",
          });
        }
      }
    </script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha1/dist/js/bootstrap.bundle.min.js"></script>
  </body>
</html>
