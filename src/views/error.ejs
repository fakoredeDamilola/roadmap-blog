<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Error</title>
    <style>
      body {
        font-family: Arial, sans-serif;
        background-color: #f8d7da;
        color: #721c24;
        text-align: center;
        padding: 50px;
      }
      .container {
        max-width: 600px;
        margin: 0 auto;
        background-color: #f5c6cb;
        padding: 20px;
        border-radius: 5px;
        box-shadow: 0 0 10px rgba(0, 0, 0, 0.1);
      }
      h1 {
        font-size: 2em;
      }
      p {
        font-size: 1.2em;
      }
    </style>
  </head>
  <body>
    <%- include('partials/header', { routes:[{name: "Home", route: "/"}],
    profilePicture: '/path/to/profile.jpg', userName: user?.username }) %>
    <div class="container">
      <h1>Error</h1>
      <p><%= error %></p>
      <p>Sorry, <%= user.name %>. Please try again later.</p>
    </div>
  </body>
</html>
