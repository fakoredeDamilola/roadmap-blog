<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Document</title>
    <link rel="stylesheet" href="/styles.css" />
  </head>
  <body>
    <%- include('partials/header', { routes:[{name: "Home", route: "/"}, {name:
    article ? "Edit Article" : "Create New Article", route: "#"}],
    profilePicture: '/path/to/profile.jpg', userName: user?.username }) %>

    <div class="new_container">
      <h1><%= article ? "Edit Article" : "New Article" %></h1>
      <section class="newArticle">
        <form
          action="<%= edit ? '/admin/edit-article/' + slug : '/admin/new-article' %>"
          method="POST"
        >
          <div>
            <label for="title">Article Title</label>
            <input
              type="text"
              name="title"
              id="title"
              value="<%= article?.title %>"
            />
          </div>
          <div>
            <label for="slug">Article Slug</label>
            <input
              type="text"
              name="slug"
              id="slug"
              value="<%= article?.slug %>"
            />
          </div>
          <div>
            <label for="description">Short Description</label>
            <input
              type="text"
              name="description"
              id="description"
              value="<%= article?.description %>"
            />
          </div>
          <div>
            <label for="content">content</label>
            <textarea name="content" id="content">
<%= article?.content %></textarea
            >
          </div>

          <div>
            <button type="submit"><%= edit ? "Update" : "Submit" %></button>
          </div>
        </form>
      </section>
    </div>
  </body>
</html>
