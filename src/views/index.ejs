<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>EJS Example</title>
    <link rel="stylesheet" href="/styles.css" />
  </head>
  <body>
    <%- include('partials/header', { routes:[{name: "Home", route: "/"}],
    profilePicture: '/path/to/profile.jpg', userName: user?.username }) %>
    <div class="container">
      <div class="header_home">
        <h1>Personal Blog</h1>
        <button>+ Add</button>
      </div>

      <ul class="comical-list">
        <% articles.forEach(function(article) { %>
        <li>
          <div class="article_flex">
            <div>
              <a href="/article/<%= article.slug %>"><%= article.title %></a>
            </div>

            <div><%= article.createdAt %></div>
          </div>

          <div class="article_description"><%= article?.description %></div>
          <h5 class="article_author"><%= article?.author?.name %></h5>
          <div class="grid-button">
            <% if (admin) { %>
            <p>Edit</p>
            <p>Delete</p>
            <% } %>
          </div>
        </li>
        <% }); %>
      </ul>
    </div>
  </body>
</html>
